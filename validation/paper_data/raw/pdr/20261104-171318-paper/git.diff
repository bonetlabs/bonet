-# delete a key (or the file) to have it found again.
-#
-# This slice (FABRIC, two VMs, three ConnectX-6 VF links):
-#   TREX enp7s0 07:00.0  ----->  SUT enp9s0   traffic in
-#   TREX enp8s0 08:00.0  <-----  SUT enp8s0   traffic out
-#   TREX enp9s0 09:00.0  -----   SUT enp7s0   control (the VMs cannot reach
-#                                             each other's management address)
-
-trex:
-  ssh: TREX                  # ssh destination from this machine (~/.ssh/config)
-  home: /home/ubuntu/bonet-bench
-  trex_dir: /opt/trex/v3.08
-  trex_version: v3.08
-  hugepages_2m: 2048
-  ports:
-    - {pci: "07:00.0", iface: enp7s0, mac: "12:6c:50:70:b9:6d"}   # port 0, tx
